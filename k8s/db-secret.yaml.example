# ---- Database Secret (template) ----
# Copy this file to db-secret.yaml, fill in your own base64-encoded
# credentials, then apply it alongside writeflow.yaml:
#   kubectl apply -f k8s/db-secret.yaml -f k8s/writeflow.yaml
#
# db-secret.yaml is gitignored so real credentials never get committed.
# In production, prefer External Secrets Operator or Sealed Secrets instead.
#
# echo -n 'your_db_user' | base64
# echo -n 'your_db_password' | base64
# echo -n 'your_db_name' | base64

apiVersion: v1
kind: Secret
metadata:
  name: writeflow-db-secret
  namespace: writeflow
  labels:
    app.kubernetes.io/part-of: writeflow
type: Opaque
data:
  POSTGRES_USER: CHANGE_ME_base64_username
  POSTGRES_PASSWORD: CHANGE_ME_base64_password
  POSTGRES_DB: CHANGE_ME_base64_dbname
